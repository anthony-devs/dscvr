{
  "manifest_version": 3,
  "name": "DSCVR: save papers, free PDFs, Ask Pinda",
  "short_name": "DSCVR",
  "version": "1.0.0",
  "description": "Save papers and pages to your DSCVR library, find free PDFs, cite in any style and ask Pinda about what you're reading.",
  "homepage_url": "https://www.askpinda.com",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Open DSCVR",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "side_panel": { "default_path": "src/panel.html" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://dscvr-server-production.up.railway.app/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://app.askpinda.com/*", "https://dscvr.askpinda.com/*", "http://localhost/*"],
      "js": ["src/connect.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Open DSCVR"
    }
  },
  "minimum_chrome_version": "116"
}
