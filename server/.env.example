# DSCVR Server Environment Variables
# Copy to .env and fill in real values.

# Firebase
FIREBASE_PROJECT_ID=dscvr-9d362
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Semantic Scholar (optional, increases rate limits)
S2_API_KEY=

# Google Pay
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_MERCHANT_NAME=DSCVR Research

# Server
PORT=8080
FLASK_DEBUG=false
