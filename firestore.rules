rules_version = '2';

// Every document lives under users/{uid}; only that user can read or write it.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Usage counters are written by Cloud Functions only.
      match /meta/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /{collection}/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && collection in ['categories', 'topics', 'materials', 'conversations']
          && request.resource.data.size() < 60;
      }

      match /materials/{itemId}/notes/{noteId} {
        allow read, write: if isOwner(uid);
      }

      match /conversations/{convId}/messages/{msgId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
